# NextSight Smart Glasses — Environment Configuration Template
# Copy this file to .env and configure local environment settings.

# Backend Application Settings
NEXTSIGHT_HOST=127.0.0.1
NEXTSIGHT_PORT=8000
NEXTSIGHT_ENV=development
NEXTSIGHT_LOG_LEVEL=INFO
NEXTSIGHT_TIMEOUT_SEC=15.0

# Telemetry Safety Verification Gate
# In development/test: false (allows synthetic testing)
# In staging/production: true (enforces fresh hardware telemetry before high-power workloads)
NEXTSIGHT_REQUIRE_VERIFIED_TELEMETRY=false

# AI Provider Selection (Options: null, mock, whisper, openai, gemini, claude)
# Default is 'null' (honest unavailable declaration) or 'mock' (deterministic offline testing)
NEXTSIGHT_STT_PROVIDER=null
NEXTSIGHT_STT_MODEL=whisper-1
# NEXTSIGHT_STT_BASE_URL=https://api.openai.com/v1

NEXTSIGHT_TTS_PROVIDER=null
NEXTSIGHT_TTS_MODEL=tts-1
NEXTSIGHT_TTS_VOICE=alloy
# NEXTSIGHT_TTS_BASE_URL=https://api.openai.com/v1

NEXTSIGHT_LLM_PROVIDER=null
NEXTSIGHT_LLM_MODEL=gpt-4o-mini
# NEXTSIGHT_LLM_BASE_URL=https://api.openai.com/v1

# Provider Credentials (Leave empty for offline / mock development)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# TTS_API_KEY=
