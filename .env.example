# NextSight Smart Glasses — Environment Configuration Template
# Copy this file to .env and configure local environment settings.

# Backend Application Settings
APP_NAME=NextSight-AI-Glasses-Backend
VERSION=0.12.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Logging & Telemetry
LOG_LEVEL=INFO
ENABLE_ACCESS_LOG=true

# Vision Pipeline Configuration (Local Software Simulation)
VISION_DEVICE=cpu
VISION_IMAGE_WIDTH=640
VISION_IMAGE_HEIGHT=480
MAX_VISION_CONCURRENCY=2

# Power & Thermal Policy Limits
LOW_BATTERY_THRESHOLD_PCT=15.0
CRITICAL_BATTERY_THRESHOLD_PCT=5.0
THERMAL_THROTTLE_THRESHOLD_C=55.0
CRITICAL_THERMAL_THRESHOLD_C=70.0

# LLM / Speech Provider Placeholders (Optional - Local Mocks Default)
# LLM_API_KEY=
# TTS_API_KEY=
